# Copy to .env and adjust. Every value shown is the default unless noted.

APP_ENV=production
ADDR=:8080
DATA_DIR=/data

# Browser origins allowed to call the API (CORS + WebSocket origin check).
ALLOWED_ORIGINS=https://www.jsonreader.com,https://jsonreader.com
# Reject mutating requests that carry no Origin header (blocks curl/scripts; browsers always send one).
REQUIRE_ORIGIN=false

# Proxies whose X-Real-IP / X-Forwarded-For are believed. When nginx on the
# host talks to the container through a published port, the container sees the
# Docker bridge address (172.16.0.0/12), so include it — otherwise every visitor
# shares one rate-limit bucket.
TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12

# ---- Compilers ----------------------------------------------------------------
SANDBOX=nsjail                 # nsjail | docker | unsafe (dev only, refused in production)
COMPILER_MAX_CONCURRENT=8      # default: 4 x number of CPUs (long runs are mostly idle)
COMPILER_QUEUE_TIMEOUT=10s
COMPILER_RUN_TIMEOUT=120s      # wall clock: sleeping / slow-printing programs may run this long
COMPILER_CPU_LIMIT=30s         # actual computation allowed per run (stops busy loops early)
COMPILER_COMPILE_TIMEOUT=30s
COMPILER_MEMORY_MB=256
COMPILER_MAX_PROCS=64
COMPILER_MAX_CODE_BYTES=131072
COMPILER_MAX_STDIN_BYTES=65536
COMPILER_MAX_OUTPUT_BYTES=1048576
COMPILER_RATE_PER_MINUTE=30    # per client IP
COMPILER_RATE_BURST=10

# ---- Markdown -> PDF (parked: build with --build-arg WITH_PDF=true to include Chromium) ----
PDF_ENABLED=false
PDF_MAX_CONCURRENT=4
PDF_RENDER_TIMEOUT=30s
PDF_MAX_INPUT_BYTES=2097152
PDF_ALLOW_REMOTE=true          # fetch public http(s) images / fonts / CSS referenced by documents
PDF_MAX_REMOTE_BYTES=20971520  # total remote bytes per document
PDF_RATE_PER_MINUTE=12
PDF_RATE_BURST=5

# ---- Code share (WebSocket) ----------------------------------------------------
COLLAB_MAX_DOC_BYTES=1048576
COLLAB_MAX_PEERS=50
COLLAB_MAX_ROOMS=50000
COLLAB_ROOM_TTL=720h           # rooms are deleted 30 days after their last edit
COLLAB_CREATE_PER_MINUTE=10
COLLAB_CONNECT_PER_MINUTE=60
COLLAB_RUNS_PER_MINUTE=20
